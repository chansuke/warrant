; Merge sort: the M0 target program.
; The spec a human approves is the clauses (:effects / :requires / :ensures / :budget).
; The bodies are what an agent writes. Contracts are proved with Z3 where possible
; (`warrant check`), perm? included, so `--contracts auto` checks nothing at run time.

(defn merge [a : (Vec i64) b : (Vec i64)] -> (Vec i64)
  (:effects [])
  (:requires (sorted? a) (sorted? b))
  (:ensures (sorted? result) (perm? result (concat a b))
    (= (len result) (+ (len a) (len b)))
    (or (empty? result)
        (and (not (empty? a)) (= (get result 0) (get a 0)))
        (and (not (empty? b)) (= (get result 0) (get b 0)))))
  (if (empty? a) b
    (if (empty? b) a
      (if (<= (get a 0) (get b 0))
        (cons (get a 0) (merge (rest a) b))
        (cons (get b 0) (merge a (rest b)))))))

(defn msort [xs : (Vec i64)] -> (Vec i64)
  (:effects [])
  (:ensures (sorted? result) (perm? result xs) (= (len result) (len xs)))
  (let [n (len xs)]
    (if (<= n 1) xs
      (let [h (/ n 2)]
        (merge (msort (slice xs 0 h)) (msort (slice xs h n)))))))

(defn gen [n : i64 seed : i64] -> (Vec i64)
  (:effects [])
  (:requires (>= n 0) (<= n 1000000) (>= seed 0) (<= seed 1000000))
  (:ensures (= (len result) n))
  (map (fn [i] (mod (+ (* i 7919) seed) 10007)) (range n)))

(defn main [] -> (Vec i64)
  (:effects [])
  (:budget (wall-ms 500))
  (slice (msort (gen 2000 42)) 0 10))
